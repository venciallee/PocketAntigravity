    { "id": "E01", "from": "UE01_AGENTS_HOME", "to": "UE02_DISPLAY_OPTIONS", "trigger": "Open Sidebar Drawer and tap Display Options filter icon" },
    { "id": "E02", "from": "UE01_AGENTS_HOME", "to": "UE03_CONTEXT_MENU_PIN", "trigger": "Open Sidebar Drawer and long-press or swipe conversation row" },
    { "id": "E04", "from": "UE01_AGENTS_HOME", "to": "UE05_CREATE_PROJECT", "trigger": "Open Sidebar Drawer and tap New Project folder+ button" },
    { "id": "E05", "from": "UE01_AGENTS_HOME", "to": "UE06_AUTOMATIONS", "trigger": "Open Sidebar Drawer and tap Automations" },
    { "id": "E06", "from": "UE01_AGENTS_HOME", "to": "UE07_CHAT_AND_COMPOSER", "trigger": "Tap Needs approval banner or conversation row Add rate limiter to /transfers" },
    { "id": "E08", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE08_ADD_CONTEXT", "trigger": "Tap + button in ChatComposerView" },
    { "id": "E09", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE09_MODEL_AND_MODE", "trigger": "Tap Gemini 4 Neon / Extra High pill in ChatComposerView" },
    { "id": "E10", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE10_STRUCTURED_QUESTION", "trigger": "Invoke /plan interview and receive ask_question step" },
    { "id": "E11", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE11_PLAN_REVIEW", "trigger": "Tap Implementation Plan artifact card" },
    { "id": "E12", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE12_TURN_DIFF_REVIEW", "trigger": "Tap +128 -14 diff badge in top bar" },
    { "id": "E13", "from": "UE07_CHAT_AND_COMPOSER", "to": "UE13_LIVE_ACTIVITY_SPEC", "trigger": "Background app while trajectory is Running or Waiting" }
  ],
  "claims": [
    { "id": "CLAIM-01", "state": "UE01_AGENTS_HOME", "description": "New Conversation Home renders Sidebar toggle, Host switcher pill, Search, Welcome greeting, amber Needs approval banner, and PC-aligned bottom Composer (Project, Branch, Cloud, +, Gemini 4 Neon / Extra High, Default preset, Mic, Send)" },
    { "id": "CLAIM-02", "state": "UE02_DISPLAY_OPTIONS", "description": "Display Options sheet renders Group By Project, Sort Conversations popover menu, Sort Projects, Filter, Display, Auto Pin / Archived Only toggles, and Mark All as Read" },
    { "id": "CLAIM-03", "state": "UE03_CONTEXT_MENU_PIN", "description": "Context Menu renders rich Plan preview card (Gemini 4 Neon), Pin/Unread/Rename/Move/Archive/Delete actions, and Swipe Pin/Archive shortcuts" },
    { "id": "CLAIM-05", "state": "UE05_CREATE_PROJECT", "description": "New Project sheet supports MacBook Pro vs Cloud runtime, GitHub vs Drive source, repo search, worktree config, and Create Project CTA" },
    { "id": "CLAIM-06", "state": "UE06_AUTOMATIONS", "description": "Automations hub (sidebar-navigated without bottom tab bar) renders NL quick-create bar, Scheduled cards with Next/Last Run stats & Run Now, Always On PR triage, Paused Resume action, and navigates to Automation Detail & Edit" },
    { "id": "CLAIM-07", "state": "UE07_CHAT_AND_COMPOSER", "description": "Chat screen renders +128 -14 badge, Thought for 14s, Plan card, 7-segment Task card, Face ID Allow/Deny command card, Stop bar, and Composer with @chip, +, Gemini 4 Neon / Extra High, Default permission preset, Mic, and Send" },
    { "id": "CLAIM-08", "state": "UE08_ADD_CONTEXT", "description": "Add Context anchored menu renders Files, Folder, Mentions, Actions, and Drive (Set up), expanding into file/mention picker or / Actions & Skills overlay" },
    { "id": "CLAIM-09", "state": "UE09_MODEL_AND_MODE", "description": "Model sheet (no Planning/Fast) renders Orchestrator, Gemini 4 Neon [New] with 4-level Thinking selector (Low/Medium/High/Extra High), Gemini 4 Carbon/Argon/Hydrogen, Claude Opus 5.5, Gemini 3.8 Flash, More models, and 5h/Weekly usage quota bars" },
    { "id": "CLAIM-10", "state": "UE10_STRUCTURED_QUESTION", "description": "Structured /plan interview Question card renders 3-step stepper pills, multi-select checkboxes, Something else write-in, Back/Next buttons, and freeform composer" },
    { "id": "CLAIM-11", "state": "UE11_PLAN_REVIEW", "description": "Implementation Plan review renders paused amber banner, MODIFY/NEW badges, pending comment card, text selection Comment/Copy callout, and Proceed / Send 2 comments bar" },
    { "id": "CLAIM-12", "state": "UE12_TURN_DIFF_REVIEW", "description": "Turn Diff review renders Turn 1..3/All pills, File 1 of 4 pager, Revert hunk, single-column line gutter with syntax diff lines, Line 29 comment composer, and Viewed / Revert file / Accept file bar" },
    { "id": "CLAIM-13", "state": "UE13_LIVE_ACTIVITY_SPEC", "description": "Live Activity & Dynamic Island renders all 7 variants: Compact Running/Waiting/Done, Minimal Ring, Expanded Running/Waiting (Face ID), and Lock Screen Multi-Agent card" }
  ]
