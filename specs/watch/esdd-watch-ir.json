{
  "specVersion": "1.1.0",
  "project": "PocketAntigravity-AppleWatch",
  "targetPlatform": {
    "os": "watchOS 11.0+",
    "swiftVersion": "6.0",
    "uiFramework": "SwiftUI (Single-Target Watch App)",
    "baselineDevice": "Apple Watch Series 10 (46mm)",
    "viewportPt": { "width": 208, "height": 248 },
    "viewportPx2x": { "width": 416, "height": 496 }
  },
  "productGuardrails": {
    "corePillars": ["status_glance", "approval_gate", "voice_task_dispatch"],
    "topLeftAction": "current_device_switcher",
    "topRightAction": "voice_new_task",
    "artifactMaxKeyPoints": 3,
    "artifactSinglePrimaryActions": ["See changes", "Proceed"],
    "noCodeDiffsOnWatch": true,
    "compactAcceptMaxFiles": 5,
    "compactAcceptRequiresZeroRisk": true,
    "doubleTapPrimaryActions": ["Allow", "Send", "Proceed", "See changes", "Accept all", "iPhone"],
    "wristUnlockPolicy": "deviceOwnerAuthenticationWithWristDetection"
  },
  "designTokens": {
    "colors": {
      "canvas": "#000000",
      "card": "#1C1C1F",
      "cardOffline": "#121214",
      "cardSelectedDevice": "#1A2435",
      "cardWorthALook": "#1E1A14",
      "elevatedButton": "#26262B",
      "topChromeCircle": "#292929",
      "accentPeriwinkle": "#8DB8FF",
      "inkOnPeriwinkle": "#0A1A33",
      "amber": "#F2B866",
      "emerald": "#6FD8A6",
      "coralRed": "#F59595"
    }
  },
  "states": [
    {
      "id": "W01_SESSIONS",
      "title": "Watch · 会话列表 (Agents Home)",
      "referencePng": "specs/watch/reference/W01_SESSIONS.png",
      "swiftView": "WatchSessionsListView",
      "requiredAccessibilityIds": [
        "watch.home.devicesButton",
        "watch.home.voiceButton",
        "watch.home.activeDeviceLabel",
        "watch.home.session."
      ]
    },
    {
      "id": "W02_DEVICES",
      "title": "Watch · 在线设备 (Devices)",
      "referencePng": "specs/watch/reference/W02_DEVICES.png",
      "swiftView": "WatchDevicesView",
      "requiredAccessibilityIds": [
        "watch.devices.back",
        "watch.devices.row."
      ]
    },
    {
      "id": "W03_CHAT_STREAM",
      "title": "Watch · 对话流 (Chat Stream)",
      "referencePng": "specs/watch/reference/W03_CHAT_STREAM.png",
      "swiftView": "WatchChatStreamView",
      "requiredAccessibilityIds": [
        "watch.nav.back",
        "watch.chat.artifactCard",
        "watch.chat.diffPill",
        "watch.chat.voiceFab"
      ]
    },
    {
      "id": "W04_ARTIFACT_SUMMARY",
      "title": "Watch · 产物摘要 (Walkthrough / Plan)",
      "referencePng": "specs/watch/reference/W04_ARTIFACT_SUMMARY.png",
      "swiftView": "WatchArtifactSummaryView",
      "requiredAccessibilityIds": [
        "watch.nav.back",
        "watch.artifact.openOnPhone",
        "watch.artifact.seeChanges"
      ]
    },
    {
      "id": "W05_CHANGED_FILES_COMPACT",
      "title": "Watch · 改动文件（少量，≤5 且无风险项）",
      "referencePng": "specs/watch/reference/W05_CHANGED_FILES_COMPACT.png",
      "swiftView": "WatchChangedFilesView",
      "requiredAccessibilityIds": [
        "watch.nav.back",
        "watch.changes.file.",
        "watch.changes.openOnPhone",
        "watch.changes.acceptAll"
      ]
    },
    {
      "id": "W06_CHANGED_FILES_GROUPED",
      "title": "Watch · 改动文件（>5 或含风险项，按意图分组）",
      "referencePng": "specs/watch/reference/W06_CHANGED_FILES_GROUPED.png",
      "swiftView": "WatchChangedFilesView",
      "requiredAccessibilityIds": [
        "watch.nav.back",
        "watch.changes.worthALook.",
        "watch.changes.group.",
        "watch.changes.handoffIPhone"
      ]
    },
    {
      "id": "W07_VOICE_INPUT",
      "title": "Watch · 语音输入 (Voice New Task / Reply)",
      "referencePng": "specs/watch/reference/W07_VOICE_INPUT.png",
      "swiftView": "WatchVoiceInputView",
      "requiredAccessibilityIds": [
        "watch.voice.close",
        "watch.voice.targetSelector",
        "watch.voice.transcript",
        "watch.voice.stopButton",
        "watch.voice.sendButton"
      ]
    },
    {
      "id": "W08_APPROVAL_NOTIFICATION",
      "title": "Watch · 通知（待批准）",
      "referencePng": "specs/watch/reference/W08_APPROVAL_NOTIFICATION.png",
      "swiftView": "WatchApprovalNotificationView",
      "requiredAccessibilityIds": [
        "watch.approval.title",
        "watch.approval.command",
        "watch.approval.allow",
        "watch.approval.deny",
        "watch.approval.replyByVoice"
      ]
    }
  ],
  "events": [
    { "id": "WE01", "from": "W01_SESSIONS", "to": "W02_DEVICES", "trigger": "Tap top-left current device button or device label" },
    { "id": "WE02", "from": "W02_DEVICES", "to": "W01_SESSIONS", "trigger": "Select online device or tap back" },
    { "id": "WE03", "from": "W01_SESSIONS", "to": "W07_VOICE_INPUT", "trigger": "Tap top-right periwinkle mic button (Voice New Task)" },
    { "id": "WE04", "from": "W01_SESSIONS", "to": "W03_CHAT_STREAM", "trigger": "Tap any session platter row" },
    { "id": "WE05", "from": "W03_CHAT_STREAM", "to": "W04_ARTIFACT_SUMMARY", "trigger": "Tap Walkthrough or Plan artifact card" },
    { "id": "WE06", "from": "W03_CHAT_STREAM", "to": "W05_CHANGED_FILES_COMPACT", "trigger": "Tap diff summary pill (<= 5 files AND zero risk items)" },
    { "id": "WE07", "from": "W03_CHAT_STREAM", "to": "W06_CHANGED_FILES_GROUPED", "trigger": "Tap diff summary pill (> 5 files OR any risk item)" },
    { "id": "WE08", "from": "W03_CHAT_STREAM", "to": "W07_VOICE_INPUT", "trigger": "Tap bottom-right floating voice FAB (Reply to session)" },
    { "id": "WE09", "from": "W03_CHAT_STREAM", "to": "W08_APPROVAL_NOTIFICATION", "trigger": "Tap pending approval amber banner" },
    { "id": "WE10", "from": "W04_ARTIFACT_SUMMARY", "to": "W05_CHANGED_FILES_COMPACT", "trigger": "Tap See changes primary CTA" },
    { "id": "WE11", "from": "W08_APPROVAL_NOTIFICATION", "to": "W07_VOICE_INPUT", "trigger": "Tap Reply by voice button" }
  ],
  "claims": [
    { "id": "WCLAIM-01", "state": "W01_SESSIONS", "assertion": "Agents home maps top-left to device switcher and top-right to voice new task, rendering waiting/running/done rows with 0px horizontal overflow." },
    { "id": "WCLAIM-02", "state": "W02_DEVICES", "assertion": "Devices screen highlights selected online host with periwinkle stroke, renders Cloud and offline host timestamps, and switches host on tap." },
    { "id": "WCLAIM-03", "state": "W03_CHAT_STREAM", "assertion": "Chat stream displays running step status, voice user bubble, concise agent reply, tappable artifact card, diff pill, and floating mic FAB." },
    { "id": "WCLAIM-04", "state": "W04_ARTIFACT_SUMMARY", "assertion": "Artifact summary strictly renders title + <= 3 numbered points + a single Double-Tap primary action (See changes or wrist-unlocked Proceed)." },
    { "id": "WCLAIM-05", "state": "W05_CHANGED_FILES_COMPACT", "assertion": "Compact changes (<= 5 files AND zero risk items) displays no source code, only A/M/D file rows with one-line summaries and wrist-unlocked Accept all." },
    { "id": "WCLAIM-06", "state": "W06_CHANGED_FILES_GROUPED", "assertion": "Changes with > 5 files OR any risk item display WORTH A LOOK first, fold mechanical edits into GROUPED clusters, hide Accept all, and hand off to iPhone." },
    { "id": "WCLAIM-07", "state": "W07_VOICE_INPUT", "assertion": "Voice input supports creating a New task (from W01 top-right) or replying to existing sessions, with waveform and Double-Tap Send CTA." },
    { "id": "WCLAIM-08", "state": "W08_APPROVAL_NOTIFICATION", "assertion": "Approval notification displays command context, Double-Tap Allow gated by watchOS wrist-detection unlock, Deny, and Reply by voice." }
  ],
  "testCases": [
    "WTC-01", "WTC-02", "WTC-03", "WTC-04", "WTC-05", "WTC-06",
    "WTC-07", "WTC-08", "WTC-09", "WTC-10", "WTC-11", "WTC-12",
    "WTC-13", "WTC-14"
  ]
}
