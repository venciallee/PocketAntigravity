<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".AntigravityApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Antigravity"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ESDD & Deep Link Routing: agpocket://verify/<case>, agpocket://cascade/<id>, agpocket://pair?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agpocket" />
            </intent-filter>
            <!-- Remote Control QR deep link handoff from system camera (`https://antigravity.google.com/r/<uuid>`) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="antigravity.google.com" android:pathPrefix="/r/" />
                <data android:scheme="https" android:host="antigravity.google" android:pathPrefix="/r/" />
            </intent-filter>

            <!-- Native Android Share Receiver (no 30MB iOS extension limit) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Transparent Biometric Trampoline launched from Android 16 Live Update / Lock Screen Approve button -->
        <activity
            android:name=".ui.liveprogress.BiometricApprovalTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Antigravity.Translucent" />

        <!-- Foreground Progress Service (Android 10-15 fallback & Android 16 Live Updates owner) -->
        <service
            android:name=".ui.liveprogress.AgentProgressForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification quick actions (Deny / Stop) & Live Update dismiss tracking -->
        <receiver
            android:name=".ui.liveprogress.LiveProgressActionReceiver"
            android:exported="false" />

        <!-- Jetpack Glance Multi-Agent Home Screen Widget -->
        <receiver
            android:name=".ui.liveprogress.AntigravityAgentsGlanceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/antigravity_agents_widget_info" />
        </receiver>
    </application>
</manifest>
